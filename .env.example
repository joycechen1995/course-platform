# PostgreSQL 連線字串（必填）。
# 本機開發可以用 docker 起一個 Postgres：
#   docker run -d --name course-platform-db -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres
# 然後設定：
DATABASE_URL=postgres://postgres:postgres@localhost:5432/course_platform

# 也可以直接指向雲端的免費方案，例如 Render / Supabase / Neon 提供的 Postgres 執行個體，
# 該情況下連線字串通常已經包含帳號密碼與 host，直接整組貼上即可。

# 用來簽署登入 session cookie 的隨機字串（必填，正式環境請務必設定，
# 未設定時會使用內建的不安全預設值，僅適合本機開發）。
SESSION_SECRET=change-me-to-a-random-string
